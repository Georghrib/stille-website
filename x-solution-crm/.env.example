# X-Solution CRM – Konfiguration
# Diese Datei als ".env" in den Domain-Ordner kopieren (neben public_html, NICHT hinein)
# und die Werte eintragen. Die .env niemals ins Repository hochladen.

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Öffentliche Adresse ohne abschließenden Schrägstrich, z. B. https://crm.x-solution.at
APP_URL=

# easybill: Einstellungen → API → API-Schlüssel
EASYBILL_API_KEY=

# Lange Zufallswerte (mind. 32 Zeichen), z. B. aus einem Passwortgenerator
WEBHOOK_SECRET=
CRON_SECRET=

# Optional:
# APP_DEBUG=false
# DB_PORT=3306
# EASYBILL_BASE_URL=https://api.easybill.de/rest/v1
